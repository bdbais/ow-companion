    <!-- About -->
    <string name="about_title">OW Companion</string>
    <string name="about_intro">A non-commercial fan project. Not affiliated with or endorsed by Blizzard Entertainment.</string>
    <string name="about_data_title">Where the data comes from</string>
    <string name="about_data_wiki">Hero statistics, abilities, release dates and the full balance history come from the Overwatch Wiki, licensed CC BY-SA.</string>
    <string name="about_data_overfast">Portraits, ability icons and the hero roster come from Blizzard\'s own site through the OverFast API.</string>
    <string name="about_data_owdmgchart">The damage simulation and its 2020 reference dataset derive from owdmgchart by yfp, MIT licensed.</string>
    <string name="about_art_title">Artwork and names</string>
    <string name="about_art">Hero portraits, ability icons, names and artwork are the property of Blizzard Entertainment, used under Blizzard\'s Fan Content Policy. This app is free, carries no advertising and sells nothing.</string>
