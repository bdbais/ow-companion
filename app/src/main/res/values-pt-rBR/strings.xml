    <string name="sens_title">Sensibilidade com mira</string>
    <string name="sens_intro">A sensibilidade relativa com a mira aberta é uma porcentagem da sua sensibilidade normal, definida por herói. Uma volta completa percorre a mesma distância de mouse em 100%; valores mais baixos igualam como a mira parece, e não o quanto ela gira.</string>
    <string name="sens_fov">Campo de visão %1$d</string>
    <string name="sens_match_centre">Centro da tela</string>
    <string name="sens_match_ratio">Proporção dos campos de visão</string>
    <string name="sens_match_centre_note">O movimento no meio da tela coincide, respeitando a perspectiva. Conhecido como distância de monitor em 0%.</string>
    <string name="sens_match_ratio_note">A proporção simples entre os dois campos de visão. Mais grosseira, porque uma tela é plana, mas se sustenta melhor perto das bordas.</string>
    <string name="sens_scope_fov">a mira aproxima para %1$s</string>
    <string name="sens_convert_title">Igualar outra mira</string>
    <string name="sens_convert_intro">Digite o ajuste que já parece certo em %1$s e o campo de visão da mira que você quer igualar. O controle acima não influencia: duas miras comparadas com a mesma visão normal ficam comparadas entre si.</string>
    <string name="sens_from">Ajuste de %1$s</string>
    <string name="sens_target_fov">FOV daquela mira</string>
